<MudNavMenu Bordered="true" Margin="Margin.Dense" Color="Color.Primary" Class="pa-1 d-flex flex-column" Style="height: 100%;">
    <MudTooltip Text="Dashboard" Placement="Placement.Right" Arrow="true">
        <MudNavLink Class="d-flex justify-center align-center" Href="dashboard" Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Rounded.Dashboard">Dashboard</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Decks" Placement="Placement.Right" Arrow="true">
        <MudNavLink Class="d-flex justify-center align-center" Href="decks" Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Rounded.LibraryBooks">Decks</MudNavLink>
    </MudTooltip>
    <MudTooltip Text="Insights" Placement="Placement.Right" Arrow="true">
        <MudNavLink Class="d-flex justify-center align-center" Href="insights" Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Rounded.Insights">Insights</MudNavLink>
    </MudTooltip>

    <div class="mt-auto">
        <MudTooltip Text="Settings" Placement="Placement.Right" Arrow="true">
            <MudNavLink Class="d-flex justify-center align-center" Href="settings" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.Settings">Settings</MudNavLink>
        </MudTooltip>
    </div>
</MudNavMenu>
