@using HazelNet_Application.CQRS.Abstractions
@using HazelNet_Application.CQRS.Features.User.Command
@using MudBlazor

@inject ICommandHandler<UpdateUserPasswordCommand> UpdateUserPasswordCommandHandler

<MudDialog>

    <TitleContent>
        <div style="display: flex; align-items: center; gap: 10px;">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" Color="Color.Primary"/>
            <MudText Typo="Typo.h6" Style="font-weight: 600;">Change Password</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-5">
            Your new password must be at least 8 characters and include an uppercase letter and a number.
        </MudText>

        <MudForm @ref="_form" @bind-IsValid="_isValid">

            <MudTextField T="string"
                          @bind-Value="_currentPassword"
                          Label="Current Password"
                          Variant="Variant.Outlined"
                          InputType="@_currentPasswordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_currentPasswordIcon"
                          OnAdornmentClick="ToggleCurrentPasswordVisibility"
                          Required="true"
                          RequiredError="Current password is required."
                          Class="mb-4"/>

            <MudTextField T="string"
                          @bind-Value="_newPassword"
                          Label="New Password"
                          Variant="Variant.Outlined"
                          InputType="@_newPasswordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_newPasswordIcon"
                          OnAdornmentClick="ToggleNewPasswordVisibility"
                          Required="true"
                          RequiredError="New password is required."
                          Validation="@(new Func<string, string?>(ValidateNewPassword))"
                          Class="mb-1"/>

            @* Strength indicator *@
            @if (!string.IsNullOrEmpty(_newPassword))
            {
                <div style="margin-bottom: 16px;">
                    <MudProgressLinear Value="@_passwordStrengthPct"
                                       Color="@_passwordStrengthColor"
                                       Rounded="true"
                                       Size="Size.Small"
                                       Class="mb-1"/>
                    <MudText Typo="Typo.caption" Color="@_passwordStrengthColor">
                        @_passwordStrengthLabel
                    </MudText>
                </div>
            }

            <MudTextField T="string"
                          @bind-Value="_confirmPassword"
                          Label="Confirm New Password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="Please confirm your new password."
                          Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                          Class="mb-2"/>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3 rounded-lg">
                    @_errorMessage
                </MudAlert>
            }

        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text"
                   Color="Color.Default"
                   Style="text-transform: none;">
            Cancel
        </MudButton>
        <MudButton OnClick="Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_isSubmitting)"
                   Style="text-transform: none; border-radius: 8px; font-weight: 600; min-width: 130px;">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                <span>Saving…</span>
            }
            else
            {
                <span>Save Changes</span>
            }
        </MudButton>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int UserId { get; set; }

    private MudForm _form      = default!;
    private bool    _isValid;
    private bool    _isSubmitting;
    private string? _errorMessage;

    private string _currentPassword = string.Empty;
    private string _newPassword     = string.Empty;
    private string _confirmPassword = string.Empty;

    // ── Visibility toggles ────────────────────────────────────────────────────
    private bool _showCurrent;
    private bool _showNew;

    private InputType _currentPasswordInputType => _showCurrent ? InputType.Text : InputType.Password;
    private string    _currentPasswordIcon       => _showCurrent
        ? Icons.Material.Outlined.VisibilityOff
        : Icons.Material.Outlined.Visibility;

    private InputType _newPasswordInputType => _showNew ? InputType.Text : InputType.Password;
    private string    _newPasswordIcon       => _showNew
        ? Icons.Material.Outlined.VisibilityOff
        : Icons.Material.Outlined.Visibility;

    private void ToggleCurrentPasswordVisibility() => _showCurrent = !_showCurrent;
    private void ToggleNewPasswordVisibility()     => _showNew     = !_showNew;

    // ── Password strength ─────────────────────────────────────────────────────
    private double _passwordStrengthPct   = 0;
    private Color  _passwordStrengthColor = Color.Error;
    private string _passwordStrengthLabel = "";

    private void ComputeStrength(string value)
    {
        if (string.IsNullOrEmpty(value)) { _passwordStrengthPct = 0; return; }

        int score = 0;
        if (value.Length >= 8)                     score++;
        if (value.Length >= 12)                    score++;
        if (value.Any(char.IsUpper))               score++;
        if (value.Any(char.IsDigit))               score++;
        if (value.Any(c => !char.IsLetterOrDigit(c))) score++;

        (_passwordStrengthPct, _passwordStrengthColor, _passwordStrengthLabel) = score switch
        {
            <= 1 => (20,  Color.Error,   "Weak"),
            2    => (40,  Color.Warning, "Fair"),
            3    => (60,  Color.Warning, "Moderate"),
            4    => (80,  Color.Success, "Strong"),
            _    => (100, Color.Success, "Very Strong")
        };
    }

    // ── Validation ────────────────────────────────────────────────────────────
    private string? ValidateNewPassword(string value)
    {
        ComputeStrength(value);
        if (string.IsNullOrWhiteSpace(value)) return "New password is required.";
        if (value.Length < 8)                return "Must be at least 8 characters.";
        if (!value.Any(char.IsUpper))        return "Must include at least one uppercase letter.";
        if (!value.Any(char.IsDigit))        return "Must include at least one number.";
        return null;
    }

    private string? ValidateConfirmPassword(string value)
        => value != _newPassword ? "Passwords do not match." : null;

    // ── Actions ───────────────────────────────────────────────────────────────
    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid) return;

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var command = new UpdateUserPasswordCommand(UserId, _currentPassword, _newPassword);
            await UpdateUserPasswordCommandHandler.Handle(command);
            
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            // Assuming your handler/repository throws an exception if the current password is wrong
            _errorMessage = ex.Message; 
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
