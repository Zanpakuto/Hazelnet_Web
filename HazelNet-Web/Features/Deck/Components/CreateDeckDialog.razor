@using System.ComponentModel.DataAnnotations
@using HazelNet_Application.CQRS.Features.Decks.Commands
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText>Create New Deck</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Color="Color.Inherit"
                           aria-label="close dialog"
                           OnClick="ConfirmCloseAsync" />
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudDivider/>
        <MudStack Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mt-3">
            <MudTextField T="string" @bind-Value="_deckName" Label="Enter Deck Name (required)"
                          Clearable="true" Variant="Variant.Outlined" ShrinkLabel="true"
                          Lines="1" Sizing="InputSizing.Auto" FullWidth="true"
                          Counter="100" MaxLength="100" Immediate="true"
                          Class="@(_deckName?.Length >= 85 ? "counter-warn" : "")"/>
            <MudTextField T="string" @bind-Value="_description" Label="Enter Deck Description"
                          Clearable="true" Variant="Variant.Outlined" ShrinkLabel="true"
                          Lines="5" Sizing="InputSizing.Auto" FullWidth="true"
                          Counter="250" MaxLength="250" Immediate="true"
                          Class="@(_description?.Length >= 213 ? "counter-warn" : "")"/>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="ConfirmCloseAsync" Variant="Variant.Outlined">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" 
                   Variant="Variant.Outlined"
                   Disabled="@(string.IsNullOrEmpty(_deckName))">Save Deck</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int UserId { get; set; }
    [Parameter] public string? InitialName { get; set; }
    [Parameter] public string? InitialDescription { get; set; }
    [Parameter] public int? DeckId { get; set; }

    [Required(ErrorMessage = "Deck Name is required.")]
    private string _deckName = string.Empty;
    private string? _description;

    protected override void OnInitialized()
    {
        _deckName = InitialName ?? "";
        _description = InitialDescription ?? "";
    }

    private void Submit()
    {
        var result = new CreateDeckCommand(
            DeckName: _deckName,
            DeckDescription: _description
        );


        if (DeckId.HasValue)
        {
            MudDialog.Close(
                DialogResult.Ok(
                    new UpdateDeckCommand(DeckId.Value, _deckName, _description ?? string.Empty)));
        } 
        else
            MudDialog.Close(DialogResult.Ok(result));
    }

    private async Task ConfirmCloseAsync()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            title: "Close",
            message: "Are you sure you want to close? Your changes will be lost",
            yesText: "Close",
            cancelText: "Cancel");

        if (confirm is true)
        {
            MudDialog.Cancel();
        }
    }
}