@using HazelNet_Application.CQRS.Abstractions
@using HazelNet_Application.CQRS.Abstractions.Identity
@using HazelNet_Application.CQRS.Features.Cards.Commands
@using HazelNet_Application.CQRS.Features.Cards.Queries
@using HazelNet_Domain.Models
@using HazelNet_Domain.Services.FSRS
@inject ISnackbar Snackbar
@inject IQueryHandler<GetAllDueCardsQuery, List<Card>> GetAllDueCardsQueryHandler;
@inject ICommandHandler<StudyCardCommand> StudyCardCommandHandler;
@inject ICurrentUserService CurrentUserService;


<MudDialog>
    <TitleContent>
        @DeckName
    </TitleContent>
    
    <DialogContent>
        <MudGrid>
            <MudItem sm="12">
                <MudStack Row="true" 
                          AlignItems="AlignItems.Center" 
                          Justify="Justify.SpaceBetween"
                          Spacing="5">
                    <MudText Typo="Typo.h6">
                        Progress
                    </MudText>
                    
                    <MudText Typo="Typo.h6">
                        @_progress/@_numberOfDueCards
                    </MudText>
                </MudStack>               
            </MudItem>
            
            <MudItem sm="12">
                <MudProgressLinear 
                    Color="Color.Info" 
                    Value="@_progress" 
                    Size="Size.Small"
                    Min="0"
                    Max="@_numberOfDueCards"
                    Rounded="true"/>
            </MudItem>
        </MudGrid>
        
        <MudDivider
            DividerType="DividerType.FullWidth"
            Class="my-5"/>
        
        <MudPaper Elevation="0"
                  Class="pa-5 ma-5">
            
            @if (_isLoading)
            {
                <MudProgressCircular Indeterminate="true" Class="d-flex mx-auto my-10"/>
            }
            else if (_hasNoDueCards)
            {
                <MudText Typo="Typo.h5" Align="Align.Center" Class="my-10">
                    No cards due for review! Come back later.
                </MudText>
            }
            else
            {
                if (_progress < _numberOfDueCards)
                {
                    <MudPaper Elevation="0" Class="pa-5 ma-5">
                        <MudCardContent>
                            <MudText Typo="Typo.h1" Align="Align.Center" Class="my-10">
                                @_currentQA
                            </MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       DropShadow="true"
                                       Size="Size.Large"
                                       FullWidth="true"
                                       OnClick="@FlipCard">
                                @_showAnswerOrQuestion
                            </MudButton>
                        </MudCardActions>
                    </MudPaper>
                }
                else
                {
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="my-10">
                        Finished all cards due for review! Come back later.
                    </MudText>
                }
                
            }
        </MudPaper>
        
        <MudDivider
            DividerType="DividerType.FullWidth"
            Class="my-5"/>
    </DialogContent>
    
    <DialogActions>
        @if (_progress < _numberOfDueCards)
        {
            <MudStack Spacing="0"
                      AlignItems="AlignItems.Stretch"
                      Style="width: 100%; padding: 8px 16px;">
                @if (_isShowingAnswer)
                {
                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="3">
                        <MudStack Spacing="3"
                                  Row="true"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceEvenly"
                                  Class="mb-3"
                                  Style="flex: 1;">

                            <MudButton Size="Size.Large"
                                       DropShadow="false"
                                       Variant="@(IsSelected(Rating.Easy) ? Variant.Filled : Variant.Outlined)"
                                       Color="@(IsSelected(Rating.Easy) ? Color.Success : Color.Default)"
                                       Style="@(IsSelected(Rating.Easy)
                                           ? "flex: 1; color: white; background-color: #16a34a; border-color: #16a34a"
                                           : "flex: 1; color: #16a34a; border-color: #16a34a")"
                                       OnClick="() => SelectRating(Rating.Easy)">
                                <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                    <MudText Style="@(IsSelected(Rating.Easy) ? "color: white;" : string.Empty)">Easy</MudText>
                                    <MudText Typo="Typo.caption" Style="@(IsSelected(Rating.Easy) ? "color: white; opacity: 0.85" : "opacity: 0.8")">@FormatInterval(Rating.Easy)</MudText>
                                </MudStack>
                            </MudButton>
                            <MudButton Size="Size.Large"
                                       DropShadow="false"
                                       Variant="@(IsSelected(Rating.Good) ? Variant.Filled : Variant.Outlined)"
                                       Color="@(IsSelected(Rating.Good) ? Color.Warning : Color.Default)"
                                       Style="@(IsSelected(Rating.Good)
                                           ? "flex: 1; color: white; background-color: #d97706; border-color: #d97706"
                                           : "flex: 1; color: #d97706; border-color: #d97706")"
                                       OnClick="() => SelectRating(Rating.Good)">
                                <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                    <MudText Style="@(IsSelected(Rating.Good) ? "color: white;" : string.Empty)">Good</MudText>
                                    <MudText Typo="Typo.caption" Style="@(IsSelected(Rating.Good) ? "color: white; opacity: 0.85" : "opacity: 0.8")">@FormatInterval(Rating.Good)</MudText>
                                </MudStack>
                            </MudButton>
                            <MudButton Size="Size.Large"
                                       DropShadow="false"
                                       Variant="@(IsSelected(Rating.Hard) ? Variant.Filled : Variant.Outlined)"
                                       Color="@(IsSelected(Rating.Hard) ? Color.Error : Color.Default)"
                                       Style="@(IsSelected(Rating.Hard)
                                           ? "flex: 1; color: white; background-color: #dc2626; border-color: #dc2626"
                                           : "flex: 1; color: #dc2626; border-color: #dc2626")"
                                       OnClick="() => SelectRating(Rating.Hard)">
                                <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                    <MudText Style="@(IsSelected(Rating.Hard) ? "color: white;" : string.Empty)">Hard</MudText>
                                    <MudText Typo="Typo.caption" Style="@(IsSelected(Rating.Hard) ? "color: white; opacity: 0.85" : "opacity: 0.8")">@FormatInterval(Rating.Hard)</MudText>
                                </MudStack>
                            </MudButton>
                        </MudStack>

                        <MudButton Size="Size.Large"
                                   DropShadow="false"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(!_selectedRating.HasValue)"
                                   Style="min-width: 88px; min-height: 56px; align-self: flex-start; padding: 10px 14px;"
                                   OnClick="AdvanceCardAsync">
                            Next
                        </MudButton>
                    </MudStack>

                    <MudButton Size="Size.Large"
                               DropShadow="false"
                               Variant="@(IsSelected(Rating.Again) ? Variant.Filled : Variant.Outlined)"
                               Color="@(IsSelected(Rating.Again) ? Color.Error : Color.Default)"
                               Style="@(IsSelected(Rating.Again)
                                   ? "color: white; background-color: #dc2626; border-color: #dc2626"
                                   : "color: #dc2626; border-color: #dc2626")"
                               FullWidth="true"
                               OnClick="() => SelectRating(Rating.Again)">
                        <MudStack Spacing="0" Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center">
                            <MudText Style="@(IsSelected(Rating.Again) ? "color: white;" : string.Empty)">Again</MudText>
                            <MudText Typo="Typo.caption" Class="ml-2" Style="@(IsSelected(Rating.Again) ? "color: white; opacity: 0.85" : "opacity: 0.8")">@FormatInterval(Rating.Again)</MudText>
                        </MudStack>
                    </MudButton>
                }
                else
                {
                    <MudStack Spacing="3"
                              Row="true"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceEvenly"
                              Class="mb-3">

                        <MudButton Size="Size.Large"
                                   DropShadow="false"
                                   Variant="Variant.Outlined"
                                   Disabled="true"
                                   Style="flex: 1; color: #16a34a; border-color: #16a34a">
                            <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                <MudText>Easy</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.8">@FormatInterval(Rating.Easy)</MudText>
                            </MudStack>
                        </MudButton>
                        <MudButton Size="Size.Large"
                                   DropShadow="false"
                                   Variant="Variant.Outlined"
                                   Disabled="true"
                                   Style="flex: 1; color: #d97706; border-color: #d97706">
                            <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                <MudText>Good</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.8">@FormatInterval(Rating.Good)</MudText>
                            </MudStack>
                        </MudButton>
                        <MudButton Size="Size.Large"
                                   DropShadow="false"
                                   Variant="Variant.Outlined"
                                   Disabled="true"
                                   Style="flex: 1; color: #dc2626; border-color: #dc2626">
                            <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                <MudText>Hard</MudText>
                                <MudText Typo="Typo.caption" Style="opacity: 0.8">@FormatInterval(Rating.Hard)</MudText>
                            </MudStack>
                        </MudButton>
                    </MudStack>

                    <MudButton Size="Size.Large"
                               DropShadow="false"
                               Variant="Variant.Filled"
                               Color="Color.Error"
                               Disabled="true"
                               FullWidth="true">
                        <MudStack Spacing="0" Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center">
                            <MudText>Again</MudText>
                            <MudText Typo="Typo.caption" Class="ml-2" Style="opacity: 0.8">@FormatInterval(Rating.Again)</MudText>
                        </MudStack>
                    </MudButton>
                }
            </MudStack>
        }
        else
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Medium"
                       OnClick="FinishSession">
                Go Back
            </MudButton>
        }
        
    </DialogActions>
    
</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    
    [Parameter] public int DeckId { get; set; }
    [Parameter]  public required string DeckName { get; set; }
    
    private List<Card> _dueCards = new();
    private Card? _currentCard;
    private int _numberOfDueCards;
    private int _progress = 0;
    private int UserId;
    
    private bool _isLoading = true;
    private bool _hasNoDueCards = false;


    protected override async Task OnInitializedAsync()
    {
        var userIdString = await CurrentUserService.GetUserIdAsync();
        
        if (!int.TryParse(userIdString, out UserId))
        {
            throw new Exception("User is not authenticated or token is invalid.");
        }
        
        try
        {
            var query = new GetAllDueCardsQuery(DeckId);
            _dueCards = await GetAllDueCardsQueryHandler.Handle(query);
            _numberOfDueCards = _dueCards.Count;
            _currentCard = _dueCards.FirstOrDefault();
            _hasNoDueCards = _dueCards.Count == 0;
            UpdatePreview();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load cards: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool _isShowingAnswer = false;
    private RecordLog? _preview;
    private Rating? _selectedRating;

    private string _currentQA => _currentCard == null ? "" :
        _isShowingAnswer
        ? _currentCard.BackOfCard ?? "(No answer)"
        : _currentCard.FrontOfCard ?? string.Empty;

    private void UpdatePreview()
    {
        if (_currentCard == null) { _preview = null; return; }
        var fsrs = FSRS.NewFSRS(Parameters.DefaultParam());
        _preview = fsrs.Repeat(_currentCard, DateTime.UtcNow);
    }

    private string FormatInterval(Rating rating)
    {
        if (_preview == null || !_preview.ContainsKey(rating)) return "";
        var days = _preview[rating].Card.ScheduledDays;
        if (days == 0) return "<1d";
        if (days == 1) return "1d";
        if (days < 30) return $"{days}d";
        if (days < 365) return $"{days / 30}mo";
        return $"{days / 365}y";
    }

    private string _showAnswerOrQuestion => _isShowingAnswer
        ? "Show Question"
        : "Show Answer";

    private void FlipCard()
    {
        if (_currentCard == null) return;
        _isShowingAnswer = !_isShowingAnswer;
        if (!_isShowingAnswer)
        {
            _selectedRating = null;
        }
    }
    
    private void SelectRating(Rating rating)
    {
        if (!_isShowingAnswer) return;

        _selectedRating = rating;
    }

    private bool IsSelected(Rating rating) => _selectedRating == rating;

    private async Task AdvanceCardAsync()
    {
        if (_currentCard == null || !_selectedRating.HasValue) return;

        try
        {
            var rating = _selectedRating.Value;
            var command = new StudyCardCommand(UserId, DeckId, _currentCard.Id, rating);
            await StudyCardCommandHandler.Handle(command);

            _progress++;
            _dueCards.RemoveAt(0);
            _selectedRating = null;

            if (_dueCards.Count == 0)
            {
                return;
            }

            _currentCard = _dueCards[0];
            _isShowingAnswer = false;
            UpdatePreview();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving review: {ex.Message}", Severity.Error);
        }
    }

    private async Task FinishSession()
    {
        MudDialog.Close(DialogResult.Ok(true));
        Snackbar.Add($"Studying {DeckName} deck complete!", Severity.Success);
    }
}
